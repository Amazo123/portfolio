---
import { site } from '../lib/site';
import { url } from '../lib/url';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="shell footer__inner">
    <div class="footer__grid">
      <div class="footer__col">
        <p class="footer__heading mono">Contact</p>
        <a class="footer__link" href={`mailto:${site.email}`}>
          <Icon name="mail" size={14} />
          <span>{site.email}</span>
        </a>
        <a class="footer__link" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
        <p class="footer__meta">{site.location}</p>
      </div>

      <div class="footer__col">
        <p class="footer__heading mono">Elsewhere</p>
        <a class="footer__link" href={site.github} rel="me noopener" target="_blank">
          <Icon name="github" size={14} />
          <span>{site.githubLabel}</span>
        </a>
        <a class="footer__link" href={site.linkedin} rel="me noopener" target="_blank">
          <Icon name="linkedin" size={14} />
          <span>{site.linkedinLabel}</span>
        </a>
        <a class="footer__link" href={url('/resume.pdf')}>
          <Icon name="resume" size={14} />
          <span>Resume — PDF</span>
        </a>
      </div>

      <div class="footer__col">
        <p class="footer__heading mono">Currently</p>
        <p class="footer__meta">
          Final-year B.Eng. Computer Engineering at the University of Maiduguri. Finished my SIWES
          internship at NASCOMSOFT EMBEDED, Bauchi in November. Open to embedded / firmware roles
          and internships.
        </p>
      </div>
    </div>

    <div class="footer__base">
      <p class="footer__meta mono">© {year} {site.name} · Maiduguri, Nigeria</p>
      <p class="footer__meta mono footer__uptime">uptime {year} · no trackers · static html</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--bg-2);
    padding-block: clamp(2.5rem, 5vw, 4rem) 1.75rem;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer__col { display: flex; flex-direction: column; gap: 0.55rem; align-items: flex-start; }

  .footer__heading { color: var(--dim); margin-bottom: 0.35rem; }

  .footer__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 0.2s var(--ease);
  }
  .footer__link:hover { color: var(--accent); }
  .footer__link :global(svg) { flex: none; opacity: 0.75; }
  .footer__link:hover :global(svg) { opacity: 1; }

  .footer__meta { color: var(--dim); font-size: 0.82rem; line-height: 1.6; }

  .footer__base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-soft);
  }

  .footer__uptime { color: var(--dim); }

  @media (max-width: 760px) {
    .footer__grid { grid-template-columns: 1fr; gap: 1.75rem; }
    .footer__base { flex-direction: column; gap: 0.35rem; }
  }
</style>
