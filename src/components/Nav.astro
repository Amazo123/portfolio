---
import { site, nav } from '../lib/site';
import { url } from '../lib/url';

const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const clean = href.replace(/\/$/, '');
  return clean !== '' && (path === clean || path.startsWith(clean + '/'));
};
const isHome = path === '' || path === import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="nav">
  <div class="nav__inner shell">
    <a class="nav__brand" href={url('/')} aria-label="Home">
      <span class="nav__mark" aria-hidden="true">
        <span class="nav__mark-bar"></span><span class="nav__mark-bar"></span><span class="nav__mark-bar"></span>
      </span>
      <span class="nav__name">{site.name}</span>
      <span class="nav__role mono">{site.role}</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {nav.map((item) => (
        <a class:list={['nav__link', { 'is-active': isActive(item.href) }]} href={url(item.href)}>{item.label}</a>
      ))}
    </nav>

    <a class="nav__cta mono" href={`mailto:${site.email}`}>Contact</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--nav-h);
    background: rgba(2, 4, 4, 0.82);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--line-soft);
  }

  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav__brand {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
  }

  .nav__mark {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    align-self: center;
    padding: 4px 5px;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: var(--panel-teal);
  }

  .nav__mark-bar {
    width: 2px;
    background: var(--accent);
    display: block;
  }
  .nav__mark-bar:nth-child(1) { height: 6px; opacity: 0.55; }
  .nav__mark-bar:nth-child(2) { height: 11px; }
  .nav__mark-bar:nth-child(3) { height: 8px; opacity: 0.75; }

  .nav__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .nav__role {
    color: var(--dim);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    white-space: nowrap;
  }

  .nav__links {
    display: flex;
    gap: 0.25rem;
    margin-left: auto;
  }

  .nav__link {
    position: relative;
    padding: 0.45rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    border-radius: 2px;
    transition: color 0.2s var(--ease), background-color 0.2s var(--ease);
  }

  .nav__link:hover { color: var(--text); background: var(--panel); }

  .nav__link.is-active { color: var(--accent); }

  .nav__cta {
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    color: var(--text);
    font-size: 0.66rem;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .nav__cta:hover { border-color: var(--accent); color: var(--accent); background: rgba(45, 212, 191, 0.06); }

  @media (max-width: 720px) {
    .nav__role, .nav__cta { display: none; }
    .nav__links { margin-left: auto; }
    .nav__link { padding: 0.45rem 0.6rem; font-size: 0.66rem; }
  }
</style>
