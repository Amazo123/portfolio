---
import { site, nav } from '../lib/site';
import { url } from '../lib/url';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const clean = href.replace(/\/$/, '');
  return clean !== '' && (path === clean || path.startsWith(clean + '/'));
};
const isHome = path === '' || path === import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="nav">
  <div class="nav__inner shell">
    <a class="nav__brand" href={url('/')} aria-label="Home">
      <span class="nav__mark" aria-hidden="true">
        <span class="nav__mark-bar"></span><span class="nav__mark-bar"></span><span class="nav__mark-bar"></span>
      </span>
      <span class="nav__name">{site.name}</span>
      <span class="nav__role mono">{site.role}</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {nav.map((item) => (
        <a class:list={['nav__link', { 'is-active': isActive(item.href) }]} href={url(item.href)}>{item.label}</a>
      ))}
    </nav>

    <a class="nav__cta mono" href={site.emailCompose} target="_blank" rel="noopener">Contact</a>

    <button class="nav__theme" type="button" data-theme-toggle aria-label="Switch to light theme" title="Switch theme">
      <span class="nav__theme-icon nav__theme-icon--on"><Icon name="sun" size={14} /></span>
      <span class="nav__theme-icon nav__theme-icon--off"><Icon name="moon" size={14} /></span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--nav-h);
    background: var(--nav-bg);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--line-soft);
  }

  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav__brand {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
  }

  .nav__mark {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    align-self: center;
    padding: 4px 5px;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: var(--panel-teal);
  }

  .nav__mark-bar {
    width: 2px;
    background: var(--accent);
    display: block;
  }
  .nav__mark-bar:nth-child(1) { height: 6px; opacity: 0.55; }
  .nav__mark-bar:nth-child(2) { height: 11px; }
  .nav__mark-bar:nth-child(3) { height: 8px; opacity: 0.75; }

  .nav__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .nav__role {
    color: var(--dim);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    white-space: nowrap;
  }

  .nav__links {
    display: flex;
    gap: 0.25rem;
    margin-left: auto;
  }

  .nav__link {
    position: relative;
    padding: 0.45rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    border-radius: var(--radius-pill);
    transition: color 0.2s var(--ease), background-color 0.2s var(--ease);
  }

  .nav__link:hover { color: var(--text); background: var(--panel); }

  .nav__link.is-active { color: var(--accent); }

  .nav__cta {
    padding: 0.5rem 1.05rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    color: var(--text);
    font-size: 0.66rem;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .nav__cta:hover { border-color: var(--accent); color: var(--accent); background: var(--btn-hover-bg); }

  /* theme toggle — sun shows in dark mode, moon in light mode */
  .nav__theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .nav__theme:hover { border-color: var(--accent); color: var(--accent); background: var(--btn-hover-bg); }

  .nav__theme-icon { display: none; align-items: center; justify-content: center; }
  :global(:root:not([data-theme='light'])) .nav__theme-icon--on { display: inline-flex; }
  :global(:root[data-theme='light']) .nav__theme-icon--off { display: inline-flex; }

  @media (max-width: 720px) {
    .nav__role, .nav__cta { display: none; }
    .nav__links { margin-left: auto; }
    .nav__link { padding: 0.45rem 0.6rem; font-size: 0.66rem; }
  }
</style>

<script>
  // Theme toggle — persists to localStorage; the boot script in Base.astro
  // reads it back before first paint, so there is no flash either way.
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  const apply = (t: 'dark' | 'light') => {
    document.documentElement.setAttribute('data-theme', t);
    try { localStorage.setItem('theme', t); } catch { /* storage blocked */ }
    if (btn) btn.setAttribute('aria-label', t === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
    if (meta) meta.setAttribute('content', t === 'dark' ? '#020404' : '#f6f5f1');
  };

  btn?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    apply(next);
  });
</script>
