---
interface Props {
  height?: number;
  bars?: number;
  class?: string;
}
const { height = 64, bars = 48 } = Astro.props;
---
<div class="wave" data-wave style={`height:${height}px`} aria-hidden="true">
  <canvas width={bars * 6} height={height}></canvas>
</div>

<style>
  .wave {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .wave canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  /**
   * Centre-symmetric bar waveform — an instrument-panel activity strip.
   * Heights are driven by layered sine noise so the motion reads as
   * "live signal" rather than as random flicker. Static under reduced motion.
   */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-wave]').forEach((host) => {
    const canvas = host.querySelector('canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const H = canvas.height;
    const W = canvas.width;
    const barW = 3;
    const gap = 3;
    const count = Math.floor(W / (barW + gap));

    const heights: number[] = new Array(count).fill(0).map((_, i) => {
      const base = Math.sin(i * 0.32) * 0.5 + Math.sin(i * 0.11 + 1.7) * 0.35 + 0.5;
      return Math.max(0.12, Math.min(1, base * (0.55 + Math.abs(Math.sin(i * 0.05)) * 0.6)));
    });

    function draw(scale: number) {
      if (!ctx) return;
      ctx.clearRect(0, 0, W, H);
      // palette follows the active theme (darker inks on the light canvas)
      const light = document.documentElement.getAttribute('data-theme') === 'light';
      const cBase = light ? '#0c8577' : '#2dd4bf';
      const cDeep = light ? '#0a5d54' : '#0f766e';
      const cHot = light ? '#a16207' : '#f5b942';
      const mid = H / 2;
      for (let i = 0; i < count; i++) {
        const n = (heights[i] * scale) % 1.25;
        const h = Math.max(2, n * (H * 0.92));
        const x = i * (barW + gap);
        const hot = n > 1.02;
        ctx.fillStyle = hot ? cHot : i % 11 === 0 ? cDeep : cBase;
        ctx.globalAlpha = hot ? 0.9 : 0.62 + n * 0.3;
        ctx.fillRect(x, mid - h / 2, barW, h);
      }
      ctx.globalAlpha = 1;
    }

    if (reduce) {
      draw(1);
      return;
    }

    let raf = 0;
    let t = 0;
    let running = false;

    const tick = () => {
      t += 0.012;
      // "gate" behaviour: mostly calm, occasionally spikes like a burst arriving
      const burst = Math.max(0, Math.sin(t * 0.7) ** 8) + Math.max(0, Math.sin(t * 2.3 + 1) ** 16) * 0.6;
      draw(0.85 + burst * 1.6);
      raf = requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver((es) => {
      for (const e of es) {
        if (e.isIntersecting && !running) {
          running = true;
          raf = requestAnimationFrame(tick);
        } else if (!e.isIntersecting && running) {
          running = false;
          cancelAnimationFrame(raf);
        }
      }
    });
    io.observe(host);
  });

  // Static (reduced-motion) waves drew once at load — redraw when the theme flips.
  if (reduce && 'MutationObserver' in window) {
    new MutationObserver(() => {
      document.querySelectorAll<HTMLElement>('[data-wave]').forEach((host) => {
        const canvas = host.querySelector('canvas');
        const ctx = canvas?.getContext('2d');
        if (!canvas || !ctx) return;
        const H = canvas.height;
        const W = canvas.width;
        const barW = 3;
        const gap = 3;
        const count = Math.floor(W / (barW + gap));
        const mid = H / 2;
        const light = document.documentElement.getAttribute('data-theme') === 'light';
        const cBase = light ? '#0c8577' : '#2dd4bf';
        const cDeep = light ? '#0a5d54' : '#0f766e';
        const cHot = light ? '#a16207' : '#f5b942';
        ctx.clearRect(0, 0, W, H);
        for (let i = 0; i < count; i++) {
          const base = Math.sin(i * 0.32) * 0.5 + Math.sin(i * 0.11 + 1.7) * 0.35 + 0.5;
          const hgt = Math.max(0.12, Math.min(1, base * (0.55 + Math.abs(Math.sin(i * 0.05)) * 0.6)));
          const n = (hgt * 0.85) % 1.25;
          const h = Math.max(2, n * (H * 0.92));
          const hot = n > 1.02;
          ctx.fillStyle = hot ? cHot : i % 11 === 0 ? cDeep : cBase;
          ctx.globalAlpha = hot ? 0.9 : 0.62 + n * 0.3;
          ctx.fillRect(i * (barW + gap), mid - h / 2, barW, h);
        }
        ctx.globalAlpha = 1;
      });
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>
