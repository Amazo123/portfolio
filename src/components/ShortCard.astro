---
import type { ShortCard } from '../lib/projects';

interface Props {
  card: ShortCard;
}
const { card } = Astro.props;
const tone = {
  accent: 'var(--accent)',
  amber: 'var(--amber)',
  green: 'var(--green)',
  rose: 'var(--rose)',
  plain: 'var(--muted)',
}[card.accent];
---
<article class="short" style={`--tone:${tone}`}>
  <div class="short__head mono">
    <span class="tnum">{card.year}</span>
    <span class="short__status">{card.status}</span>
  </div>
  <h3 class="short__title">{card.title}</h3>
  <p class="short__body">{card.summary}</p>
  <div class="short__foot">
    <div class="chips">
      {card.tags.map((t) => <span class="chip">{t}</span>)}
    </div>
    <p class="short__src mono">{card.source}</p>
  </div>
</article>

<style>
  .short {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    height: 100%;
    padding: clamp(1.2rem, 2vw, 1.6rem);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }

  .short:hover { border-color: var(--line-strong); background: var(--panel-2); }

  .short__head {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.62rem;
    color: var(--dim);
  }

  .short__status { color: var(--tone); text-align: right; }

  .short__title {
    font-size: 1.08rem;
    letter-spacing: -0.015em;
    color: var(--text);
    line-height: 1.25;
  }

  .short__body { color: var(--muted); font-size: 0.87rem; line-height: 1.6; }

  .short__foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding-top: 0.4rem;
  }

  .short__src { color: var(--dim); font-size: 0.6rem; }
</style>
