---
import type { CaseStudy } from '../lib/projects';
import { url } from '../lib/url';

interface Props {
  project: CaseStudy;
  /** show the hero metric block */
  metric?: boolean;
}

const { project, metric = true } = Astro.props;
const accentVar = {
  accent: 'var(--accent)',
  amber: 'var(--amber)',
  green: 'var(--green)',
  rose: 'var(--rose)',
  blue: 'var(--blue)',
}[project.accent];
---
<a class="case" href={url(`/work/${project.slug}/`)} style={`--tone:${accentVar}`}>
  <div class="case__head mono">
    <span class="case__index">{project.index}</span>
    <span class="case__sep" aria-hidden="true">/</span>
    <span class="case__kind">{project.kind}</span>
    <span class="case__year tnum">{project.year}</span>
  </div>

  <h3 class="case__title">{project.title}</h3>
  <p class="case__subtitle">{project.subtitle}</p>

  <p class="case__summary">{project.summary}</p>

  {metric && (
    <div class="case__metric">
      <span class="case__metric-value tnum">{project.heroMetric.value}</span>
      <span class="case__metric-label mono">{project.heroMetric.label}</span>
    </div>
  )}

  <div class="case__foot">
    <div class="chips">
      {project.tags.map((t) => <span class="chip">{t}</span>)}
    </div>
    <span class="case__more mono">Case study <span class="btn__arrow" aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .case {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.5rem, 2.6vw, 2.25rem);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    height: 100%;
    box-shadow: var(--card-shadow);
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease), background-color 0.3s var(--ease);
  }

  .case::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--tone);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }

  .case:hover {
    border-color: var(--line-strong);
    background: var(--panel-2);
    transform: translateY(-3px);
  }
  .case:hover::after { opacity: 0.85; }

  .case__head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.55rem;
    row-gap: 0.2rem;
    color: var(--dim);
    font-size: 0.66rem;
  }

  .case__index { color: var(--tone); font-size: 0.72rem; font-weight: 700; }
  .case__sep { color: var(--line-strong); }
  .case__kind { color: var(--dim); letter-spacing: 0.14em; }
  .case__year { margin-left: auto; color: var(--dim); }

  .case__title {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.6rem);
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--text);
    transition: color 0.25s var(--ease);
  }
  .case:hover .case__title { color: var(--tone); }

  .case__subtitle {
    color: var(--accent-hi);
    color: color-mix(in oklab, var(--tone) 70%, var(--text));
    font-size: 0.95rem;
    line-height: 1.45;
    max-width: 42ch;
  }

  .case__summary {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.62;
    max-width: 62ch;
  }

  .case__metric {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.8rem;
    row-gap: 0.3rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--line-soft);
  }

  .case__metric-value {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--tone);
    line-height: 1;
  }

  .case__metric-label {
    color: var(--dim);
    font-size: 0.62rem;
    line-height: 1.5;
    max-width: 20ch;
  }

  .case__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .case__more {
    color: var(--dim);
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }
  .case:hover .case__more { color: var(--tone); }
</style>
