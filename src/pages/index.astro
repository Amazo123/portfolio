---
import Base from '../layouts/Base.astro';
import Waveform from '../components/Waveform.astro';
import CaseCard from '../components/CaseCard.astro';
import ShortCard from '../components/ShortCard.astro';
import Icon from '../components/Icon.astro';
import { caseStudies, shortCards, timeline } from '../lib/projects';
import { site } from '../lib/site';
import { url } from '../lib/url';

const description =
  'Amazing Adelowo builds embedded systems: firmware, sensors and radios for devices that do their thinking on the chip. Final-year computer engineering student at the University of Maiduguri. On this site: an on-device infant cry monitor, a hackathon-winning attendance terminal, an e-voting machine with live results, and a robot fleet.';

const toneVar = {
  accent: 'var(--accent)',
  amber: 'var(--amber)',
  green: 'var(--green)',
  rose: 'var(--rose)',
  blue: 'var(--blue)',
} as const;

// One instrument panel per flagship build — equal weight, no single project
// carries the hero.
const rack = [
  { slug: 'crynet', tag: 'CRYNET', what: 'infant cry → caregiver’s wrist, all on-device', proof: 'AUC 0.9993 · 0 FA / 308 windows', tone: 'accent' },
  { slug: 'attendx', tag: 'ATTENDX', what: 'biometric attendance that photographs proxy clock-ins', proof: '1st overall · TEAM RAMP', tone: 'amber' },
  { slug: 'evoting', tag: 'E-VOTING', what: 'fingerprint-gated ballot terminal, live cloud tally', proof: '20 parties · Neon + Render', tone: 'green' },
  { slug: 'swarm', tag: 'SWARM', what: 'electromagnet-coupled robots that dock & carry', proof: '3 robots · PWM calibrated', tone: 'blue' },
] as const;
---
<Base title={site.name} description={description} ogImage="/img/og/default.png">
  <!-- Hero -->
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="hero__eyebrow mono" data-reveal>
          <span class="hero__status-dot" aria-hidden="true"></span>
          <span class="hero__ticker pixel"><span data-ticker>LISTENING</span></span>
          <span class="hero__loc dim tnum">6.9° N · Maiduguri, NG</span>
        </p>

        <h1 class="display" data-reveal style="--delay:60ms">
          Amazing<br />
          <span class="hero__accent">Adelowo</span>
        </h1>

        <p class="hero__role mono" data-reveal style="--delay:120ms">Embedded systems engineer</p>

        <p class="lede" data-reveal style="--delay:180ms">
          I build embedded systems: the schematic, the solder, the firmware and the radio, all one
          chain. Recent bench work includes a biometric attendance terminal that took 1st place at
          our company hackathon, an e-voting machine with live cloud results, a fleet of three
          docking robots, and a cot-side cry monitor that runs its neural network on the chip
          itself.
        </p>

        <div class="hero__actions" data-reveal style="--delay:240ms">
          <a class="btn btn--primary" href={url('/work/')}>Selected work <span class="btn__arrow" aria-hidden="true">→</span></a>
          <a class="btn" href={url('/resume.pdf')}>Resume · PDF</a>
        </div>

        <div class="hero__meta mono" data-reveal style="--delay:300ms">
          <span>{site.location}</span>
          <span aria-hidden="true">/</span>
          <span>B.Eng. Computer Engineering ’27 · UNIMAID</span>
          <span aria-hidden="true">/</span>
          <span class="accent">open to embedded roles</span>
        </div>
      </div>

      <div class="hero__device" data-reveal style="--delay:200ms">
        <div class="rack">
          <div class="rack__head">
            <span class="rack__title pixel">BENCH INDEX</span>
            <Waveform height={30} />
            <span class="rack__count mono tnum">4 UNITS</span>
          </div>
          {rack.map((r) => (
            <a class="rack__unit" href={url(`/work/${r.slug}/`)} style={`--tone:${toneVar[r.tone]}`}>
              <span class="rack__top mono">
                <span class="rack__dot" aria-hidden="true"></span>
                <span class="rack__tag pixel">{r.tag}</span>
                <span class="rack__go" aria-hidden="true">→</span>
              </span>
              <span class="rack__what">{r.what}</span>
              <span class="rack__proof mono tnum">{r.proof}</span>
            </a>
          ))}
        </div>
        <p class="hero__device-note mono">every unit on this bench was wired, flashed and measured by hand</p>
      </div>
    </div>
  </section>

  <!-- Proof strip -->
  <section class="section--tight proof">
    <div class="shell">
      <div class="stats" data-reveal>
        <div class="stat">
          <p class="stat__value tnum">0.9993</p>
          <p class="stat__label">CryNet test AUC · INT8 model, on-chip</p>
        </div>
        <div class="stat stat--amber">
          <p class="stat__value tnum">1st</p>
          <p class="stat__label">NASCOMSOFT hackathon · AttendX</p>
        </div>
        <div class="stat stat--green">
          <p class="stat__value tnum">20</p>
          <p class="stat__label">Party choices on the e-voting terminal, synced live</p>
        </div>
        <div class="stat stat--plain">
          <p class="stat__value tnum">13</p>
          <p class="stat__label">Builds documented here · 4 case studies, 9 bench builds</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 / Selected work -->
  <section class="section" id="work">
    <div class="shell">
      <div class="rail" data-reveal>
        <span class="rail__num">01</span>
        <span class="rail__label">Selected work</span>
        <span class="rail__line"></span>
        <a class="rail__link mono" href={url('/work/')}>All projects →</a>
      </div>
      <div class="work__grid">
        {caseStudies.map((p, i) => (
          <div data-reveal style={`--delay:${(i % 2) * 80}ms`}>
            <CaseCard project={p} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 / Also on the bench -->
  <section class="section" id="bench">
    <div class="shell">
      <div class="rail" data-reveal>
        <span class="rail__num">02</span>
        <span class="rail__label">Also on the bench</span>
        <span class="rail__line"></span>
        <span class="rail__count mono tnum">9 builds</span>
      </div>
      <p class="lede bench__lede" data-reveal>
        Shorter builds: LoRa links, LED boards, veroboard robots. Each one was soldered, scoped
        and made to work during my internship at NASCOMSOFT EMBEDED, or after hours.
      </p>
      <div class="bench__grid">
        {shortCards.map((c, i) => (
          <div data-reveal style={`--delay:${(i % 3) * 60}ms`}>
            <ShortCard card={c} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 / Timeline -->
  <section class="section" id="now">
    <div class="shell">
      <div class="rail" data-reveal>
        <span class="rail__num">03</span>
        <span class="rail__label">The record so far</span>
        <span class="rail__line"></span>
      </div>
      <ol class="tl">
        {timeline.map((t, i) => (
          <li class="tl__item" data-reveal style={`--delay:${i * 60}ms`}>
            <p class="tl__period mono tnum">{t.period}</p>
            <div class="tl__body">
              <h3 class="tl__title">{t.title}</h3>
              <p class="tl__org mono">{t.org}</p>
              <p class="tl__note">{t.note}</p>
              <div class="chips tl__chips">
                {t.tags.map((tag) => <span class="chip">{tag}</span>)}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 / Contact -->
  <section class="section contact" id="contact">
    <div class="shell">
      <div class="rail" data-reveal>
        <span class="rail__num">04</span>
        <span class="rail__label">Contact</span>
        <span class="rail__line"></span>
      </div>
      <div class="contact__grid">
        <div>
          <h2 class="display--tight" data-reveal>Get in<br /><span class="accent">touch.</span></h2>
          <p class="lede contact__lede" data-reveal style="--delay:80ms">
            I'm looking for junior embedded and firmware roles, and I'm happy to talk through a
            hard problem. Email is fastest.
          </p>
        </div>
        <div class="contact__actions" data-reveal style="--delay:140ms">
          <a class="btn btn--primary" href={`mailto:${site.email}`}>
            <Icon name="mail" size={14} />
            <span>{site.email}</span>
          </a>
          <a class="btn" href={site.github} target="_blank" rel="me noopener">
            <Icon name="github" size={14} />
            <span>GitHub ↗</span>
          </a>
          <a class="btn" href={site.linkedin} target="_blank" rel="me noopener">
            <Icon name="linkedin" size={14} />
            <span>LinkedIn ↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------- hero */
  .hero {
    padding-block: clamp(3.5rem, 8vw, 7rem) clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.85fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
    color: var(--muted);
    font-size: 0.64rem;
  }

  .hero__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    animation: blink 2.2s infinite var(--ease);
  }

  .hero__ticker {
    color: var(--accent);
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: var(--panel-teal);
    min-width: 0;
    white-space: nowrap;
    font-size: 0.5rem;
  }

  .hero__loc { margin-left: auto; white-space: nowrap; }

  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  .hero__accent { color: var(--accent); }

  .hero__role {
    margin-top: clamp(1rem, 2.5vw, 1.75rem);
    color: var(--muted);
  }

  .lede { margin-top: 1.25rem; }

  .hero__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  .hero__meta {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--dim);
    font-size: 0.62rem;
  }

  .hero__device {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-width: 0;
  }

  .hero__device-note { color: var(--dim); font-size: 0.6rem; letter-spacing: 0.1em; }

  /* ------------------------------------------------------------- rack */
  .rack {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 14px;
    background: var(--device-bg);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.12),
      var(--device-glow),
      var(--device-inset);
  }

  .rack__head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding-bottom: 0.2rem;
  }

  .rack__title { color: var(--dim); font-size: 0.5rem; white-space: nowrap; }

  .rack__head :global([data-wave]) { flex: 1; opacity: 0.8; min-width: 0; }

  .rack__count { color: var(--dim); font-size: 0.55rem; white-space: nowrap; }

  .rack__unit {
    display: block;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--device-unit);
    transition: border-color 0.25s var(--ease), background-color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .rack__unit:hover {
    border-color: var(--tone);
    background: var(--device-unit-hover);
    transform: translateX(3px);
  }

  .rack__top {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .rack__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--tone);
    box-shadow: 0 0 8px var(--tone);
  }

  .rack__tag { color: var(--tone); font-size: 0.5rem; }

  .rack__go {
    margin-left: auto;
    color: var(--dim);
    font-family: var(--font-mono);
    transition: color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .rack__unit:hover .rack__go { color: var(--tone); transform: translateX(2px); }

  .rack__what {
    display: block;
    margin-top: 0.55rem;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .rack__proof {
    display: block;
    margin-top: 0.4rem;
    color: var(--dim);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
  }

  /* ------------------------------------------------------------- proof */
  .proof { padding-top: 0; }

  /* ------------------------------------------------------------- work */
  .rail__link, .rail__count { color: var(--dim); white-space: nowrap; transition: color 0.2s var(--ease); }
  .rail__link:hover { color: var(--accent); }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  /* ------------------------------------------------------------- bench */
  .bench__lede { margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem); }

  .bench__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
  }

  /* ------------------------------------------------------------- timeline */
  .tl { list-style: none; padding: 0; }

  .tl__item {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(1.4rem, 2.5vw, 2rem);
    border-top: 1px solid var(--line-soft);
  }

  .tl__period { color: var(--accent); padding-top: 0.3rem; }

  .tl__title { font-size: clamp(1.15rem, 1rem + 0.8vw, 1.55rem); letter-spacing: -0.02em; }

  .tl__org { color: var(--dim); margin-top: 0.35rem; }

  .tl__note { color: var(--muted); margin-top: 0.65rem; max-width: 68ch; font-size: 0.93rem; }

  .tl__chips { margin-top: 0.9rem; }

  /* ------------------------------------------------------------- contact */
  .contact { border-top: 1px solid var(--line-soft); }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(260px, 0.8fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }

  .contact__lede { margin-top: 1.25rem; }

  .contact__actions {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    align-items: stretch;
  }

  .contact__actions .btn { justify-content: center; overflow-wrap: anywhere; }

  /* ------------------------------------------------------------- responsive */
  @media (max-width: 980px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__device { max-width: 420px; }
    .work__grid { grid-template-columns: 1fr; }
    .bench__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .contact__grid { grid-template-columns: 1fr; align-items: start; }
  }

  @media (max-width: 640px) {
    .bench__grid { grid-template-columns: 1fr; }
    .tl__item { grid-template-columns: 1fr; gap: 0.5rem; }
    .hero__loc { display: none; }
  }
</style>

<script>
  // Hero status ticker — console lines from across the bench, one per build,
  // every line traceable to a real measurement or feature.
  const el = document.querySelector<HTMLElement>('[data-ticker]');
  if (el) {
    const states = [
      'BENCH POWERED · 4 UNITS',
      'CRYNET · WINDOW CRC32 → MATCH',
      'CRYNET · P(CRY)=0.9961 · COT 1',
      'ATTENDX · FP MATCH · CLOCK-IN LOGGED',
      'E-VOTING · TALLY SYNCED · 20 PARTIES',
      'SWARM · PWM CALIBRATED · TRACKS TRUE',
      'LORA RA-02 · TX/RX PAIR · LINK OK',
      'P10 BOARD · 5V / 4A RAIL · OK',
      'WRIST · BLE ALERT RECEIVED',
    ];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduced) {
      let i = 0;
      setInterval(() => {
        i = (i + 1) % states.length;
        el.style.opacity = '0';
        setTimeout(() => {
          el.textContent = states[i];
          el.style.opacity = '1';
        }, 180);
      }, 2600);
      el.style.transition = 'opacity 180ms ease';
    }
  }
</script>
