---
import Base from '../layouts/Base.astro';
import Waveform from '../components/Waveform.astro';
import CaseCard from '../components/CaseCard.astro';
import ShortCard from '../components/ShortCard.astro';
import Icon from '../components/Icon.astro';
import { caseStudies, shortCards, timeline } from '../lib/projects';
import { site } from '../lib/site';
import { url } from '../lib/url';

const description =
  'Amazing Adelowo builds embedded systems: firmware, sensors and radios, from standalone edge devices to cloud-connected products. Final-year computer engineering student at the University of Maiduguri. On this site: an on-device infant cry monitor, a hackathon-winning attendance terminal, an e-voting machine with live results, and a robot fleet.';

const toneVar = {
  accent: 'var(--accent)',
  amber: 'var(--amber)',
  green: 'var(--green)',
  rose: 'var(--rose)',
  blue: 'var(--blue)',
} as const;

// One instrument panel per flagship build — equal weight, no single project
// carries the hero.
const rack = [
  { slug: 'crynet', tag: 'CRYNET', what: 'infant cry → caregiver’s wrist, all on-device', proof: 'AUC 0.9993 · 0 FA / 308 windows', tone: 'accent' },
  { slug: 'attendx', tag: 'ATTENDX', what: 'biometric attendance that photographs proxy clock-ins', proof: '1st overall · TEAM RAMP', tone: 'amber' },
  { slug: 'evoting', tag: 'E-VOTING', what: 'fingerprint-gated ballot terminal, live cloud tally', proof: '20 parties · Neon + Render', tone: 'green' },
  { slug: 'swarm', tag: 'SWARM', what: 'electromagnet-coupled robots that dock & carry', proof: '3 robots · PWM calibrated', tone: 'blue' },
] as const;

// Toolbox marquee — two rows, opposite directions. Everything here is
// verifiable against the resume; nothing aspirational.
const toolboxA = [
  'Embedded C', 'C++', 'Proteus', 'Schematic Design', 'Breadboarding',
  'Veroboard Soldering', 'Oscilloscopes', 'On-Device ML · INT8',
];
const toolboxB = [
  'ESP32', 'ESP32-S3', 'ESP32-C3', 'ATmega328P', 'Arduino Uno / Nano', 'Raspberry Pi',
  'LoRa RA-02', 'GSM SIM800L', 'Wi-Fi', 'BLE', 'I²C', 'SPI', 'UART', 'I²S',
];
---
<Base title={site.name} description={description} ogImage="/img/og/default.png">
  <!-- Hero — centered single column -->
  <section class="hero">
    <div class="shell hero__grid">
      <p class="hero__eyebrow mono" data-reveal>
        <span class="hero__status-dot" aria-hidden="true"></span>
        Open to embedded systems engineering roles and internships
      </p>

      <h1 class="display" data-reveal style="--delay:60ms">
        Amazing<br />
        <span class="hero__accent">Adelowo</span>
      </h1>

      <p class="hero__role mono" data-reveal style="--delay:120ms">Embedded systems engineer</p>

      <p class="lede" data-reveal style="--delay:180ms">
        I design and build embedded systems from schematic to prototype: sensors, actuators and the
        code that runs on the chip. Recent bench work includes a smart biometric attendance system
        that took 1st place at the NASCOMSOFT EMBEDED Hackathon 2.0, an e-voting machine with live cloud results,
        a fleet of three docking robots, and a cot-side cry monitor that runs its neural network
        on the chip itself.
      </p>

      <div class="hero__actions" data-reveal style="--delay:240ms">
        <a class="btn btn--primary" href={url('/work/')}>Selected work <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a class="btn" href={url('/resume.pdf')}>Resume · PDF</a>
      </div>

      <div class="hero__meta mono" data-reveal style="--delay:300ms">
        <span>{site.location}</span>
        <span aria-hidden="true">/</span>
        <span>B.Eng. Computer Engineering ’27 · UNIMAID</span>
        <span aria-hidden="true">/</span>
        <span>SIWES · NASCOMSOFT EMBEDED LTD</span>
      </div>
    </div>

    <div class="shell hero__device-wrap">
      <div class="rack" data-reveal style="--delay:200ms">
        <div class="rack__head">
          <span class="rack__title pixel">BENCH INDEX</span>
          <Waveform height={30} />
          <span class="rack__count mono tnum">4 UNITS</span>
        </div>
        {rack.map((r) => (
          <a class="rack__unit" href={url(`/work/${r.slug}/`)} style={`--tone:${toneVar[r.tone]}`}>
            <span class="rack__top mono">
              <span class="rack__dot" aria-hidden="true"></span>
              <span class="rack__tag pixel">{r.tag}</span>
              <span class="rack__go" aria-hidden="true">→</span>
            </span>
            <span class="rack__what">{r.what}</span>
            <span class="rack__proof mono tnum">{r.proof}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Toolbox marquee -->
  <section class="marquees" aria-label="Toolbox">
    <div class="marquee" data-reveal>
      <div class="marquee__track">
        <div class="marquee__row">
          {toolboxA.map((s) => <span class="chip">{s}</span>)}
        </div>
        <div class="marquee__row" aria-hidden="true">
          {toolboxA.map((s) => <span class="chip">{s}</span>)}
        </div>
      </div>
    </div>
    <div class="marquee" data-reveal style="--delay:80ms">
      <div class="marquee__track marquee__track--rev">
        <div class="marquee__row">
          {toolboxB.map((s) => <span class="chip">{s}</span>)}
        </div>
        <div class="marquee__row" aria-hidden="true">
          {toolboxB.map((s) => <span class="chip">{s}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- Proof strip -->
  <section class="section--tight proof">
    <div class="shell">
      <div class="stats" data-reveal>
        <div class="stat">
          <p class="stat__value tnum">0.9993</p>
          <p class="stat__label">CryNet test AUC · INT8 model, on-chip</p>
        </div>
        <div class="stat stat--amber">
          <p class="stat__value tnum">1st</p>
          <p class="stat__label">NASCOMSOFT hackathon · AttendX</p>
        </div>
        <div class="stat stat--green">
          <p class="stat__value tnum">20</p>
          <p class="stat__label">Party choices on the e-voting terminal, synced live</p>
        </div>
        <div class="stat stat--plain">
          <p class="stat__value tnum">11</p>
          <p class="stat__label">Builds documented here · 4 case studies, 7 bench builds</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 / Selected work -->
  <section class="section" id="work">
    <div class="shell">
      <div class="rail" data-reveal>
        <span class="rail__num">01</span>
        <span class="rail__label">Selected work</span>
        <span class="rail__line"></span>
        <a class="rail__link mono" href={url('/work/')}>All projects →</a>
      </div>
      <div class="work__grid">
        {caseStudies.map((p, i) => (
          <div data-reveal style={`--delay:${(i % 2) * 80}ms`}>
            <CaseCard project={p} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 / Also on the bench -->
  <section class="section" id="bench">
    <div class="shell">
      <div class="rail" data-reveal>
        <span class="rail__num">02</span>
        <span class="rail__label">Also on the bench</span>
        <span class="rail__line"></span>
        <span class="rail__count mono tnum">7 builds</span>
      </div>
      <p class="lede bench__lede" data-reveal>
        Shorter builds: LoRa links, LED matrix boards, veroboard robots. Each one was soldered,
        scoped and verified working during my internship at NASCOMSOFT EMBEDED LTD, or after hours.
      </p>
      <div class="bench__grid">
        {shortCards.map((c, i) => (
          <div data-reveal style={`--delay:${(i % 3) * 60}ms`}>
            <ShortCard card={c} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 / Timeline -->
  <section class="section" id="now">
    <div class="shell">
      <div class="rail" data-reveal>
        <span class="rail__num">03</span>
        <span class="rail__label">The record so far</span>
        <span class="rail__line"></span>
      </div>
      <ol class="tl">
        {timeline.map((t, i) => (
          <li class="tl__item" data-reveal style={`--delay:${i * 60}ms`}>
            <p class="tl__period mono tnum">{t.period}</p>
            <div class="tl__body">
              <h3 class="tl__title">{t.title}</h3>
              <p class="tl__org mono">{t.org}</p>
              <p class="tl__note">{t.note}</p>
              <div class="chips tl__chips">
                {t.tags.map((tag) => <span class="chip">{tag}</span>)}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 / Contact -->
  <section class="section contact" id="contact">
    <div class="shell">
      <div class="rail" data-reveal>
        <span class="rail__num">04</span>
        <span class="rail__label">Contact</span>
        <span class="rail__line"></span>
      </div>
      <div class="contact__grid">
        <div>
          <h2 class="display--tight" data-reveal>Get in <span class="accent">touch.</span></h2>
          <p class="lede contact__lede" data-reveal style="--delay:80ms">
            I'm looking for embedded systems engineering roles, and I'm glad to talk through a
            hard problem. Email is fastest.
          </p>
        </div>
        <div class="contact__actions" data-reveal style="--delay:140ms">
          <a class="btn btn--primary" href={site.emailCompose} target="_blank" rel="noopener">
            <Icon name="mail" size={14} />
            <span>{site.email}</span>
          </a>
          <a class="btn" href={site.github} target="_blank" rel="me noopener">
            <Icon name="github" size={14} />
            <span>GitHub ↗</span>
          </a>
          <a class="btn" href={site.linkedin} target="_blank" rel="me noopener">
            <Icon name="linkedin" size={14} />
            <span>LinkedIn ↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------- hero */
  .hero {
    padding-block: clamp(3.5rem, 8vw, 7rem) clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
  }

  .hero__grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
    padding: 0.5rem 1.05rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--panel);
    color: var(--muted);
    font-size: 0.64rem;
    white-space: nowrap;
  }

  .hero__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    animation: blink 2.2s infinite var(--ease);
  }

  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  .hero__accent { color: var(--accent); }

  .hero :global(.lede) { margin-inline: auto; }

  .hero__role {
    margin-top: clamp(1rem, 2.5vw, 1.75rem);
    color: var(--muted);
  }

  .lede { margin-top: 1.25rem; }

  .hero__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  .hero__meta {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--dim);
    font-size: 0.62rem;
  }

  /* small phones: let the availability pill wrap instead of clipping */
  @media (max-width: 720px) {
    .hero__eyebrow {
      white-space: normal;
      max-width: 36ch;
      justify-content: center;
      text-align: center;
      line-height: 1.7;
    }
  }

  .hero__device-wrap {
    max-width: 660px;
    margin-top: clamp(2.75rem, 5vw, 4.25rem);
  }

  /* ------------------------------------------------------------- rack */
  .rack {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 16px;
    background: var(--device-bg);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.12),
      var(--device-glow),
      var(--device-inset);
  }

  .rack__head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding-bottom: 0.2rem;
  }

  .rack__title { color: var(--dim); font-size: 0.5rem; white-space: nowrap; }

  .rack__head :global([data-wave]) { flex: 1; opacity: 0.8; min-width: 0; }

  .rack__count { color: var(--dim); font-size: 0.55rem; white-space: nowrap; }

  .rack__unit {
    display: block;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--device-unit);
    transition: border-color 0.25s var(--ease), background-color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .rack__unit:hover {
    border-color: var(--tone);
    background: var(--device-unit-hover);
    transform: translateX(3px);
  }

  .rack__top {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .rack__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--tone);
    box-shadow: 0 0 8px var(--tone);
  }

  .rack__tag { color: var(--tone); font-size: 0.5rem; }

  .rack__go {
    margin-left: auto;
    color: var(--dim);
    font-family: var(--font-mono);
    transition: color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .rack__unit:hover .rack__go { color: var(--tone); transform: translateX(2px); }

  .rack__what {
    display: block;
    margin-top: 0.55rem;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .rack__proof {
    display: block;
    margin-top: 0.4rem;
    color: var(--dim);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
  }

  /* ---------------------------------------------------------- marquee */
  .marquees {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding-block: clamp(1.25rem, 3vw, 2.25rem);
    overflow: hidden;
  }

  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-x 44s linear infinite;
  }

  .marquee__track--rev { animation-direction: reverse; animation-duration: 54s; }

  .marquee:hover .marquee__track { animation-play-state: paused; }

  .marquee__row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-right: 0.75rem; /* keeps the -50% loop seamless */
  }

  @keyframes marquee-x { to { transform: translateX(-50%); } }

  @media (prefers-reduced-motion: reduce) {
    .marquee { -webkit-mask-image: none; mask-image: none; }
    .marquee__track { animation: none; width: auto; }
  }

  /* ------------------------------------------------------------- proof */
  .proof { padding-top: 0; }

  /* ------------------------------------------------------------- work */
  .rail__link, .rail__count { color: var(--dim); white-space: nowrap; transition: color 0.2s var(--ease); }
  .rail__link:hover { color: var(--accent); }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  /* ------------------------------------------------------------- bench */
  .bench__lede { margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem); }

  .bench__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
  }

  /* ------------------------------------------------------------- timeline */
  .tl { list-style: none; padding: 0; }

  .tl__item {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(1.4rem, 2.5vw, 2rem);
    border-top: 1px solid var(--line-soft);
  }

  .tl__period { color: var(--accent); padding-top: 0.3rem; }

  .tl__title { font-size: clamp(1.15rem, 1rem + 0.8vw, 1.55rem); letter-spacing: -0.02em; }

  .tl__org { color: var(--dim); margin-top: 0.35rem; }

  .tl__note { color: var(--muted); margin-top: 0.65rem; max-width: 68ch; font-size: 0.93rem; }

  .tl__chips { margin-top: 0.9rem; }

  /* ------------------------------------------------------------- contact */
  .contact { border-top: 1px solid var(--line-soft); }

  .contact__grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .contact__lede { margin-top: 1.25rem; }

  .contact :global(.lede) { margin-inline: auto; }

  .contact__actions {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .contact__actions .btn { justify-content: center; overflow-wrap: anywhere; }

  /* ------------------------------------------------------------- responsive */
  @media (max-width: 980px) {
    .work__grid { grid-template-columns: 1fr; }
    .bench__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .bench__grid { grid-template-columns: 1fr; }
    .tl__item { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
